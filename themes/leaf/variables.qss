/* =========================================================================
 * QGIS Studio Leaf Light - Color Variables
 * Palette: Logo greens #4F9338 #8CBA2A #B9E339 #EAF5D6
 * Format: QGIS variables.qss, `@name: value;` per line.
 * ========================================================================= */

@accent:                  #3F7A2C;
@accent_hover:            #669A2B;
@accent_pressed:          #366825;
@icon_accent:             #396E28;
@accent_checked_border:   #396E28;
@accent_disabled:         #D2ED7E;
@accent_indeterminate:    #7CAE32;
@accent_translucent:      rgba(63, 122, 44, 0.16);
@bg_window:               #F3FAE8;
@bg_base:                 #FCFEF9;
@bg_alt:                  #F8FCF1;
@bg_dock:                 #F0F8E2;
@bg_statusbar:            #D7E9C3;
@bg_menu:                 #FAFCF5;
@bg_disabled:             #ECF3E2;
@bg_btn_status_hover:     #DFF2AB;
@bg_pressed:              #C5DD92;
@bg_hover:                #E2F3B4;
@bg_hover_raised:         #D9F099;
@bg_indicator:            #FFFFFF;
@bg_btn_hover:            #D3ED88;
@bg_selected:             #CAEA6E;
@bg_selected_active:      #B9E339;
@bg_selected_inactive:    #E5EBDC;
@bg_plugin_inactive:      #D6EE90;
@bg_plugin_sel_hover:     #A9D534;
@border:                  #C5DDB7;
