@border_indicator:        #91BC7E;
@border_list_item:        #E3F0D6;
@separator_bg:            #CFE3C1;
@text:                    #26292B;
@text_bright:             #141618;
@text_dim:                #5A5F63;
@text_disabled:           #80858A;
@text_light:              #3C4044;
@text_header:             #2E412B;
@text_placeholder:        #878C90;
