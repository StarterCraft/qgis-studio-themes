@border_indicator:        #9BCABF;
@border_list_item:        #E1EFE9;
@separator_bg:            #D0E6DF;
@text:                    #26292B;
@text_bright:             #141618;
@text_dim:                #5A5F63;
@text_disabled:           #80858A;
@text_light:              #3C4044;
@text_header:             #293E3C;
@text_placeholder:        #878C90;
@text_dark:               #FFFFFF;
@scrollbar_handle_hover:  #A2CEC3;
