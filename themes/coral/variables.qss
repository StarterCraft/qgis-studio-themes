/* =========================================================================
 * QGIS Studio Coral Light - Color Variables
 * Palette: Red row #922B1E #DC4B43 #E5999A #F8D2CE
 * Format: QGIS variables.qss, `@name: value;` per line.
 * ========================================================================= */

