@accent_indeterminate:    #BC625C;
@accent_translucent:      rgba(146, 43, 30, 0.16);
@bg_window:               #FBE6E4;
@bg_base:                 #FEF8F8;
@bg_alt:                  #FDEFEE;
@bg_dock:                 #FAE0DD;
@bg_statusbar:            #ECBEB9;
@bg_menu:                 #FDF4F3;
