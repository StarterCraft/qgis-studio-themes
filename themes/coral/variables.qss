@bg_btn_status_hover:     #F3CBCA;
@bg_pressed:              #EDA09C;
@bg_hover:                #F4CFCE;
@bg_hover_raised:         #F1C3C3;
@bg_indicator:            #FFFFFF;
@bg_btn_hover:            #EFBCBB;
